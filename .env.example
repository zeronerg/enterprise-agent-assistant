# 复制为 .env 后填写真实值。
# 环境变量规则：APP_ 前缀 + __ 分隔嵌套字段。

# ---- LLM（三档位，缺省 model/base_url 指向 ModelScope 兼容接口）----
APP_LLM__ROUTER__API_KEY=
APP_LLM__ROUTER__MODEL=qwen-turbo

APP_LLM__AGENT__API_KEY=
APP_LLM__AGENT__MODEL=qwen-plus

APP_LLM__WRITER__API_KEY=
APP_LLM__WRITER__MODEL=qwen-max

# 如使用 OpenAI 官方或其他兼容服务，按需覆盖：
# APP_LLM__AGENT__BASE_URL=https://api.openai.com/v1

# ---- 韧性策略 ----
# APP_LLM__MAX_ATTEMPTS=3
# APP_LLM__RETRY_BASE_DELAY=1.0
# APP_LLM__BREAKER_FAILURE_THRESHOLD=5
# APP_LLM__BREAKER_RECOVERY_SECONDS=30

# ---- 日志 ----
# APP_LOGGING__LEVEL=INFO
# APP_LOGGING__JSON_FORMAT=true
# APP_LOGGING__FILE_PATH=./logs/app.log

# ---- 编排层 ----
# APP_ORCHESTRATOR__USE_REAL_AGENTS=false   # true 时通过 A2A 协议调用远程 Agent
